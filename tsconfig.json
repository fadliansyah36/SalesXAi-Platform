{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@salesx-ai/design-system": [
        "./packages/design-system/src/index.ts"
      ],
      "@salesx-ai/design-tokens/native": [
        "./packages/design-tokens/generated/native.ts"
      ]
    },
    "types": [
      "google.maps",
      "node"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/mobile-sales",
    ".expo",
    "dist",
    "apps/website",
    "apps/customer-portal",
    "apps/company-portal",
    "apps/sales-portal",
    "apps/distributor-portal",
    "apps/principal-portal",
    "apps/supervisor-portal",
    "apps/super-admin"
  ]
}
