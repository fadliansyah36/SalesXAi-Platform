# SalesX-Ai FastAPI - exact Supabase project eyofuiyxalbehbqoaeny.
SUPABASE_URL=https://eyofuiyxalbehbqoaeny.supabase.co
# Use Supabase direct/session-pooler connection string for this project, TLS required.
DATABASE_URL=
SUPABASE_JWKS_URL=https://eyofuiyxalbehbqoaeny.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://eyofuiyxalbehbqoaeny.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Only needed for legacy HS256 signing keys. Leave blank for asymmetric JWKS.
SUPABASE_JWT_SECRET=
# Public project publishable key, server-side only for remote logout requests.
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key for Auth Admin and private SmartTeam evidence storage. Never expose to clients.
SUPABASE_SECRET_KEY=
APP_PUBLIC_URL=
CORS_ORIGINS=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_MAX_INACTIVE_CONNECTION_LIFETIME=300
DB_STATEMENT_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
# Server-to-server only; configure the same random value in Web and FastAPI at deployment.
# Must be the same 32+ character random value configured on the Next.js Web BFF.
SALESX_BFF_SHARED_SECRET=
AUTH_ADMIN_TIMEOUT_SECONDS=8


# Existing-user organization invitation delivery (server-side SMTP only).
# Set values in the deployment secret manager; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SalesX-Ai
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Google Maps server-only Routes API configuration; key is optional until final credential activation.
MAPS_PROVIDER=google
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_LANGUAGE=id
GOOGLE_MAPS_REGION=ID
