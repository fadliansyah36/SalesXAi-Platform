# Build from the monorepo root. Configure salesx-company to use this Dockerfile.
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
RUN npm install --global bun@1.4.5
COPY . .
RUN bun install --frozen-lockfile
RUN bun run --filter=@salesx-ai/company-portal build
RUN bun run --filter=@salesx-ai/distributor-portal build
RUN bun run --filter=@salesx-ai/principal-portal build
RUN bun run --filter=@salesx-ai/supervisor-portal build
RUN bun run --filter=@salesx-ai/super-admin build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
COPY --from=build /workspace/infrastructure/scripts/portal-gateway.mjs ./infrastructure/scripts/portal-gateway.mjs
COPY --from=build /workspace/infrastructure/scripts/verify-portal-static-runtime.mjs ./infrastructure/scripts/verify-portal-static-runtime.mjs
COPY --from=build /workspace/apps/company-portal/.next/standalone ./apps/company-portal/.next/standalone
COPY --from=build /workspace/apps/distributor-portal/.next/standalone ./apps/distributor-portal/.next/standalone
COPY --from=build /workspace/apps/principal-portal/.next/standalone ./apps/principal-portal/.next/standalone
COPY --from=build /workspace/apps/supervisor-portal/.next/standalone ./apps/supervisor-portal/.next/standalone
COPY --from=build /workspace/apps/super-admin/.next/standalone ./apps/super-admin/.next/standalone
EXPOSE 3000
CMD ["node", "infrastructure/scripts/portal-gateway.mjs", "company"]
