# Build from the monorepo root. Configure salesx-customer to use this Dockerfile.
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
RUN npm install --global bun@1.4.5
COPY . .
RUN bun install --frozen-lockfile
RUN bun run --filter=@salesx-ai/customer-portal build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
COPY --from=build /workspace/apps/customer-portal/.next/standalone ./apps/customer-portal/.next/standalone
EXPOSE 3000
CMD ["node", "apps/customer-portal/.next/standalone/apps/customer-portal/server.js"]
