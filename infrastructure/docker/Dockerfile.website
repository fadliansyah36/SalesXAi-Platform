# Build from the monorepo root. Configure salesx-website to use this Dockerfile.
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
RUN npm install --global bun@1.4.5
COPY . .
RUN bun install --frozen-lockfile
RUN bun run --filter=@salesx-ai/website build
RUN bun run --filter=@salesx-ai/sales-portal build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
COPY --from=build /workspace/infrastructure/scripts/portal-gateway.mjs ./infrastructure/scripts/portal-gateway.mjs
COPY --from=build /workspace/infrastructure/scripts/verify-portal-static-runtime.mjs ./infrastructure/scripts/verify-portal-static-runtime.mjs
COPY --from=build /workspace/apps/website/.next/standalone ./apps/website/.next/standalone
COPY --from=build /workspace/apps/sales-portal/.next/standalone ./apps/sales-portal/.next/standalone
EXPOSE 3000
CMD ["node", "infrastructure/scripts/portal-gateway.mjs", "website"]
