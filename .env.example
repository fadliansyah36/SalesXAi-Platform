# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: Client-side Google Maps Platform API key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
