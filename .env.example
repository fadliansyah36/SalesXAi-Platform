SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_PUBLIC_URL=
CORS_ORIGINS=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_MAX_INACTIVE_CONNECTION_LIFETIME=300
DB_STATEMENT_TIMEOUT_MS=30000
