# Web authentication BFF. Supabase credentials and access/refresh tokens stay server-side.
SUPABASE_URL=https://eyofuiyxalbehbqoaeny.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SALESX_API_URL=
APP_PUBLIC_URL=
SALESX_BFF_SHARED_SECRET=

# FastAPI server-only configuration. Never expose secrets to NEXT_PUBLIC_* or EXPO_PUBLIC_*.
DATABASE_URL=
SUPABASE_JWKS_URL=https://eyofuiyxalbehbqoaeny.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://eyofuiyxalbehbqoaeny.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
CORS_ORIGINS=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_MAX_INACTIVE_CONNECTION_LIFETIME=300
DB_STATEMENT_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
# Server-to-server only, 32+ chars; use the same random value in Web and FastAPI at deployment.
SALESX_BFF_SHARED_SECRET=
AUTH_ADMIN_TIMEOUT_SECONDS=8

# Invitation delivery provider; credentials are supplied only at deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SalesX-Ai
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Google Maps client configuration. Use restricted browser/Android/iOS keys only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ENABLED=false

# Public cross-portal origins. These are public URLs, not credentials.
NEXT_PUBLIC_SALESX_WEBSITE_URL=https://salesx-website-production.up.railway.app
NEXT_PUBLIC_SALESX_CUSTOMER_URL=https://salesx-customer-production.up.railway.app
NEXT_PUBLIC_SALESX_COMPANY_URL=https://salesx-company-production.up.railway.app
