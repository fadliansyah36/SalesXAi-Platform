{
  "name": "salesx-ai-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "tokens:build": "bun run --filter @salesx-ai/design-tokens build",
    "tokens:check": "bun run --filter @salesx-ai/design-tokens check",
    "build:all": "turbo run build",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "turbo run typecheck",
    "lint:all": "turbo run lint",
    "mobile:start": "bun run --filter @salesx-ai/mobile-sales start",
    "mobile:android": "bun run --filter @salesx-ai/mobile-sales android",
    "mobile:ios": "bun run --filter @salesx-ai/mobile-sales ios",
    "mobile:typecheck": "bun run --filter @salesx-ai/mobile-sales typecheck",
    "mobile:check-deps": "bun run --filter @salesx-ai/mobile-sales check-deps",
    "mobile:config": "bun run --filter @salesx-ai/mobile-sales config",
    "mobile:export:android": "bun run --filter @salesx-ai/mobile-sales export:android",
    "mobile:export:ios": "bun run --filter @salesx-ai/mobile-sales export:ios",
    "mobile:verify-start": "bun run --filter @salesx-ai/mobile-sales verify-start",
    "build:website": "bun run --filter @salesx-ai/website build",
    "start:website": "bun run --filter @salesx-ai/website start",
    "build:customer": "bun run --filter @salesx-ai/customer-portal build",
    "start:customer": "bun run --filter @salesx-ai/customer-portal start",
    "build:company": "bun run --filter @salesx-ai/company-portal build",
    "start:company": "bun run --filter @salesx-ai/company-portal start",
    "build:sales": "bun run --filter @salesx-ai/sales-portal build",
    "start:sales": "bun run --filter @salesx-ai/sales-portal start",
    "build:distributor": "bun run --filter @salesx-ai/distributor-portal build",
    "start:distributor": "bun run --filter @salesx-ai/distributor-portal start",
    "build:principal": "bun run --filter @salesx-ai/principal-portal build",
    "start:principal": "bun run --filter @salesx-ai/principal-portal start",
    "build:supervisor": "bun run --filter @salesx-ai/supervisor-portal build",
    "start:supervisor": "bun run --filter @salesx-ai/supervisor-portal start",
    "build:admin": "bun run --filter @salesx-ai/super-admin build",
    "start:admin": "bun run --filter @salesx-ai/super-admin start",
    "build:portals": "turbo run build --filter=@salesx-ai/website --filter=@salesx-ai/customer-portal --filter=@salesx-ai/company-portal --filter=@salesx-ai/sales-portal --filter=@salesx-ai/distributor-portal --filter=@salesx-ai/principal-portal --filter=@salesx-ai/supervisor-portal --filter=@salesx-ai/super-admin"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@hookform/resolvers": "^5.2.1",
    "@vis.gl/react-google-maps": "^1.10.2",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "@salesx-ai/design-system": "workspace:*",
    "@salesx-ai/design-tokens": "workspace:*",
    "@salesx-ai/api-client": "workspace:*",
    "@salesx-ai/auth-client": "workspace:*",
    "@salesx-ai/permissions": "workspace:*",
    "@salesx-ai/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "turbo": "^2.11.13",
    "@types/google.maps": "^3.66.10",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^15.5.29",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.4.5"
}
