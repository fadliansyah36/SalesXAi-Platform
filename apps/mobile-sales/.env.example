# Public HTTPS origin of the SalesX-Ai mobile Auth BFF; privileged Supabase keys are never shipped in Expo.
EXPO_PUBLIC_AUTH_BFF_URL=
# FastAPI API origin; access/refresh tokens remain in Expo SecureStore.
EXPO_PUBLIC_SALESX_API_URL=
# Optional public Supabase config for authenticated private Realtime broadcasts only.
# Publishable keys are public; NEVER place a service_role or privileged key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
