{
  "name": "@salesx-ai/mobile-sales",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "check-deps": "expo install --check",
    "config": "expo config --type public",
    "verify-start": "node ./scripts/verify-start.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@salesx-ai/api-client": "workspace:*",
    "@salesx-ai/auth-client": "workspace:*",
    "@salesx-ai/design-system": "workspace:*",
    "@salesx-ai/design-tokens": "workspace:*",
    "@salesx-ai/shared-types": "workspace:*",
    "expo": "~58.0.26",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-document-picker": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.22",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~6.0.3",
    "babel-preset-expo": "~58.0.26"
  }
}
